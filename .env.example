NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://docent:docent@localhost:5432/docent
REDIS_URL=redis://localhost:6379

# Host ports for the docker-compose services.
# Override both the port and the matching URL above if these are already taken.
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# OpenAI — used for embeddings during ingestion and for answering queries
OPENAI_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
EMBEDDING_TIMEOUT_MS=30000
# Providers are tried left to right. Every provider named here must have its
# key set, and a repeated provider:model pair fails at boot — that is what
# keeps one request from ever retrying the same model twice. The single link
# below is what the schema also defaults to, so a fresh clone starts with
# only OPENAI_API_KEY. To turn on the OpenRouter fallback the milestone
# demonstrates, comment out that line and uncomment the two below it —
# naming a provider in the chain is what makes its key mandatory.
LLM_CHAIN=openai:gpt-4.1-mini
# LLM_CHAIN=openai:gpt-4.1-mini,openrouter:google/gemini-2.5-flash
# OPENROUTER_API_KEY=sk-or-your-key-here
ANSWER_TIMEOUT_MS=60000

# Retrieval — per-arm candidate count before fusion, fused result count after,
# and the RRF constant that dampens the influence of any single high rank.
RETRIEVAL_TOP_N=20
RETRIEVAL_TOP_K=8
RRF_K=60

# Grounding — ceiling on the vector arm's nearest cosine distance above which
# the service refuses instead of calling the model. See env.schema.ts for the
# calibration this value comes from.
GROUNDING_MAX_DISTANCE=0.61568

# Question-embedding cache (Redis) — the key already carries the embedding
# model and dimensionality, so this TTL only bounds memory; it plays no part
# in keeping an entry correct. Thirty days.
CACHE_EMBEDDING_TTL_S=2592000

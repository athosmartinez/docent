NODE_ENV=development
PORT=3000

# Log line format. Unset, this follows NODE_ENV: the readable Nest console
# format in development, one JSON object per line everywhere else (a
# collector is assumed to be reading stdout/stderr, not a person watching a
# terminal). Set explicitly to override that default in either direction —
# e.g. LOG_FORMAT=pretty against a production build to watch a console
# session live, or LOG_FORMAT=json locally to see exactly what a collector
# would receive.
# LOG_FORMAT=json

DATABASE_URL=postgresql://docent:docent@localhost:5432/docent
REDIS_URL=redis://localhost:6379

# Host ports for the docker-compose services.
# Override both the port and the matching URL above if these are already taken.
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# OpenAI — used for embeddings during ingestion and for answering queries
OPENAI_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
EMBEDDING_TIMEOUT_MS=30000
# Providers are tried left to right. Every provider named here must have its
# key set, and a repeated provider:model pair fails at boot — that is what
# keeps one request from ever retrying the same model twice. The single link
# below is what the schema also defaults to, so a fresh clone starts with
# only OPENAI_API_KEY. To turn on the OpenRouter fallback the milestone
# demonstrates, comment out that line and uncomment the two below it —
# naming a provider in the chain is what makes its key mandatory.
LLM_CHAIN=openai:gpt-4.1-mini
# LLM_CHAIN=openai:gpt-4.1-mini,openrouter:google/gemini-2.5-flash
# OPENROUTER_API_KEY=sk-or-your-key-here
ANSWER_TIMEOUT_MS=60000

# Retrieval — per-arm candidate count before fusion, fused result count after,
# and the RRF constant that dampens the influence of any single high rank.
RETRIEVAL_TOP_N=20
RETRIEVAL_TOP_K=8
RRF_K=60

# Grounding — ceiling on the vector arm's nearest cosine distance above which
# the service refuses instead of calling the model. See env.schema.ts for the
# calibration this value comes from.
GROUNDING_MAX_DISTANCE=0.61568

# Question-embedding cache (Redis) — the key already carries the embedding
# model and dimensionality, so this TTL only bounds memory; it plays no part
# in keeping an entry correct. Thirty days.
CACHE_EMBEDDING_TTL_S=2592000

# Answer cache (Redis) — the key already carries the corpus version an
# answer was produced against (derived from the sources table, never a
# Redis counter). Adding or removing a ready source always invalidates the
# cache by changing the key; re-ingesting an existing one does too only when
# its refreshed timestamp becomes the newest among ready sources, which this
# TTL backstops for the cases it doesn't. Seven days.
CACHE_ANSWER_TTL_S=604800

# Rate limits (Redis-backed) — requests per minute per client address.
# THROTTLE_DEFAULT_PER_MINUTE covers every route without its own override.
# /ask and /ask/stream share one budget (answering a question, not the
# transport, is what costs tokens); /ingest gets the tightest limit because
# it spends embeddings and holds a lease. /health gets a high ceiling of its
# own — high enough that no realistic load balancer/probe/uptime-monitor
# fleet reaches it, but not unlimited, since it still runs a Postgres query
# and a Redis PING on every call.
THROTTLE_DEFAULT_PER_MINUTE=60
THROTTLE_ASK_PER_MINUTE=10
THROTTLE_INGEST_PER_MINUTE=2
THROTTLE_HEALTH_PER_MINUTE=300

# Tells Express which hop of X-Forwarded-For to trust as the real client
# address, for rate limiting. false (default, no proxy trusted) is correct
# with nothing in front of this process. Behind exactly one reverse proxy
# (a single load balancer, say), set this to 1 — a hop count, trusting only
# the entry the proxy itself appended, never anything a client prepended
# ahead of it. Also accepts a preset (loopback, linklocal, uniquelocal) or a
# comma-separated list of trusted addresses/CIDRs. The literal `true` is
# rejected at boot: it trusts every hop, which resolves req.ip to whatever
# the client itself put in the header — the opposite of what this is for.
TRUST_PROXY=false
